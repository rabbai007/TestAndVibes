# Generated scan output (any location).
vibecheck-report/

# Local config, read from the repo/target root — anchored with a leading slash
# so these patterns cannot match same-named files deeper in the tree.
# Unanchored, `vibecheck.yml` also matched .github/workflows/vibecheck.yml and
# silently excluded the workflow from commits.
/vibecheck.yml
/.vibecheckignore

# Local, intentionally-vulnerable rule fixtures used to verify the rules/ packs
# during development. Not committed: they would trip the repo's own self-scan
# (the AI rules fire on them by design). Verify with an explicit-path scan, e.g.
#   semgrep scan --config rules/vibecheck-ai.yml --no-git-ignore rule-samples/*
/rule-samples/
